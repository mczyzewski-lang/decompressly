# Klucz ElevenLabs — tylko na serwerze. Nigdy nie dodawaj prefiksu NEXT_PUBLIC_.
ELEVENLABS_API_KEY=

# Prywatny kod dostępu do płatnych endpointów /api/eleven/*.
# Wpisz ten sam kod w aplikacji: Ustawienia → ElevenLabs → Kod dostępu.
# W produkcji bez tego kodu endpointy są wyłączone.
APP_ACCESS_KEY=

# Opcjonalnie: dzienny limit znaków TTS na instancję serwera (ochrona kosztów).
ELEVENLABS_DAILY_CHAR_LIMIT=60000

# Optional: requests per minute per IP (default 240 for generation, 120 otherwise)
# RATE_LIMIT_PER_MIN=240
